{
  "name": "warband",
  "version": "0.0.0",
  "private": true,
  "description": "Runs a coding task through fixed stages by orchestrating installed agent CLIs",
  "type": "module",
  "bin": {
    "warband": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "warband": "node src/cli.ts",
    "doctor": "node src/cli.ts doctor",
    "spike": "node scripts/spike/probe.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"app/src/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p app/tsconfig.json",
    "postinstall": "node scripts/link.ts",
    "ui": "node src/cli.ts ui"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "app"
  ],
  "overrides": {
    "dompurify": "^3.4.18"
  }
}
